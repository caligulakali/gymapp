# .gitignore

# Dependencies
node_modules
.pnp
.pnp.js

# Build output
dist
dist-ssr
*.local
build

# Caches
.vite
.cache
*.tsbuildinfo

# Test coverage
coverage

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Personal working documents (spec and agent rules — local only)
PROJECT_SPEC.md
AGENTS.md
ARCHITECTURE.md
tech_debt/

# Environment variables (secrets)
.env
.env.*
!.env.example

# Editors and IDEs
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

